+	c.JSON(http.StatusOK, gin.H{
+		"available": true,
+		"is_repo":   true,
+		"branch":    strings.TrimSpace(branchResult.Stdout),
+		"status":    statusResult.Stdout,
+		"remotes":   maskGitOutput(remoteResult.Stdout),
+		"log":       logResult.Stdout,
+	})
