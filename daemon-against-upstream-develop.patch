@@ -0,0 +1,80 @@
+name: Development Release
+
+on:
+  push:
+    branches:
+      - develop
+  workflow_dispatch:
+
+concurrency:
+  group: development-release-${{ github.ref }}
+  cancel-in-progress: true
+
+jobs:
+  release:
+    name: Build and Publish Development Release
+    runs-on: ubuntu-24.04
+    permissions:
+      contents: write
+    steps:
+      - name: Code checkout
+        uses: actions/checkout@8e8c483db84b4bee98b60c0593521ed34d9990e8 # v6.0.1
+
+      - name: Setup Go
+        uses: actions/setup-go@7a3fe6cf4cb3a834922a1244abfce67bcef6a0c5 # v6.2.0
+        with:
+          go-version: 1.24.11
+
+      - name: Build binaries
+        env:
+          CGO_ENABLED: 0
+          SRC_PATH: github.com/pterodactyl/wings
+        run: |
+          set -euo pipefail
+
+          mkdir -p dist
+          version="dev-${GITHUB_SHA:0:7}"
+
+          for arch in amd64 arm64; do
+            GOOS=linux GOARCH="${arch}" go build -v -trimpath -ldflags="-s -w -X ${SRC_PATH}/system.Version=${version}" -o "dist/wings_linux_${arch}" "${SRC_PATH}"
+            chmod 755 "dist/wings_linux_${arch}"
+
+            GOOS=linux GOARCH="${arch}" go build -v -trimpath -ldflags="-X ${SRC_PATH}/system.Version=${version}" -o "dist/wings_linux_${arch}_debug" "${SRC_PATH}"
+            chmod 755 "dist/wings_linux_${arch}_debug"
+          done
+
+          sha256sum dist/* > dist/SHA256SUMS
+
+      - name: Publish rolling prerelease
+        env:
+          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
+          TAG_NAME: dev-latest
+          RELEASE_TITLE: Wings development build
+        run: |
+          set -euo pipefail
+
+          git config user.name "github-actions[bot]"
+          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
+          git tag -f "${TAG_NAME}" "${GITHUB_SHA}"
+          git push origin "refs/tags/${TAG_NAME}" --force
+
+          cat > RELEASE_NOTES.md <<EOF
+          Automated development build from \`${GITHUB_REF_NAME}\`.
+
+          Commit: ${GITHUB_SHA}
+          Workflow: ${GITHUB_SERVER_URL}/${GITHUB_REPOSITORY}/actions/runs/${GITHUB_RUN_ID}
+          EOF
+
+          if gh release view "${TAG_NAME}" >/dev/null 2>&1; then
+            gh release edit "${TAG_NAME}" \
+              --title "${RELEASE_TITLE}" \
+              --notes-file RELEASE_NOTES.md \
+              --prerelease
+          else
+            gh release create "${TAG_NAME}" \
+              --title "${RELEASE_TITLE}" \
+              --notes-file RELEASE_NOTES.md \
+              --prerelease
+          fi
+
+          gh release upload "${TAG_NAME}" dist/* --clobber
