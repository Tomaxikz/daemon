+				DefaultInbound:  "allow",
+				DefaultOutbound: "allow",
+				Chains:          []networkpolicy.Chain{},
+				Rules:           []networkpolicy.Rule{},
+			},
+			Bandwidth: networkpolicy.Bandwidth{},
+		},
+	}
