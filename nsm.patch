+func policySettings(t *testing.T, id string, policy json.RawMessage) json.RawMessage {
+	t.Helper()
+	settings := map[string]any{
+		"uuid":        id,
+		"allocations": map[string]any{"mappings": map[string][]int{"192.0.2.1": {25565}}},
+	}
