+
+	gitBlockedNetworks = []*net.IPNet{
+		mustParseGitCIDR("0.0.0.0/8"),
+		mustParseGitCIDR("10.0.0.0/8"),
+		mustParseGitCIDR("100.64.0.0/10"),
+		mustParseGitCIDR("127.0.0.0/8"),
+		mustParseGitCIDR("169.254.0.0/16"),
