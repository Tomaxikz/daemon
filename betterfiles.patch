+func (h *Handler) betterFilesCollabSend(event Event, payload any) error {
+	data, err := json.Marshal(payload)
+	if err != nil {
+		return err
+	}
+	return h.SendJson(Message{Event: event, Args: []string{string(data)}})
+}
