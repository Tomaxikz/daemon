+func gitHelperPath(value string) string {
+	if value == gitContainerRoot {
+		return gitHelperRoot
+	}
+	if strings.HasPrefix(value, gitContainerRoot+"/") {
+		return gitHelperRoot + strings.TrimPrefix(value, gitContainerRoot)
+	}
+	return value
+}
