+func TestNativeFileCollabWebsocketFlow(t *testing.T) {
+	const (
+		serverUUID = "11111111-1111-1111-1111-111111111111"
+		path       = "/config.txt"
+		otherPath  = "/other.txt"
+	)
+	s := nativeFileCollabTestServer(t, serverUUID)
+	require.NoError(t, os.WriteFile(filepath.Join(s.Filesystem().Path(), "config.txt"), []byte("hello"), 0o644))
+	require.NoError(t, os.WriteFile(filepath.Join(s.Filesystem().Path(), "other.txt"), []byte("isolated"), 0o644))
+
+	sender, senderConn, senderCtx := nativeFileCollabTestHandler(t, s, "sender")
+	recipient, recipientConn, recipientCtx := nativeFileCollabTestHandler(t, s, "recipient")
+	isolated, isolatedConn, isolatedCtx := nativeFileCollabTestHandler(t, s, "isolated")
+
+	require.NoError(t, sender.HandleInbound(senderCtx, Message{Event: FileCollabSubscribeEvent, Args: []string{path}}))
+	syncMessage := nativeFileCollabRequireEvent(t, senderConn, fileCollabSyncEvent, 3)
+	require.Equal(t, path, syncMessage.Args[0])
+	require.JSONEq(t, `{"dirty":false}`, syncMessage.Args[2])
+	nativeFileCollabRequireEvent(t, senderConn, fileCollabParticipantsEvent, 2)
+
+	require.NoError(t, recipient.HandleInbound(recipientCtx, Message{Event: FileCollabSubscribeEvent, Args: []string{path}}))
+	nativeFileCollabRequireEvent(t, recipientConn, fileCollabSyncEvent, 3)
+	nativeFileCollabRequireEvent(t, senderConn, fileCollabParticipantsEvent, 2)
+	participants := nativeFileCollabRequireEvent(t, recipientConn, fileCollabParticipantsEvent, 2)
+	var participantList []nativeFileCollabParticipant
+	require.NoError(t, json.Unmarshal([]byte(participants.Args[1]), &participantList))
+	require.Len(t, participantList, 2)
+
+	require.NoError(t, isolated.HandleInbound(isolatedCtx, Message{Event: FileCollabSubscribeEvent, Args: []string{otherPath}}))
+	nativeFileCollabRequireEvent(t, isolatedConn, fileCollabSyncEvent, 3)
+	nativeFileCollabRequireEvent(t, isolatedConn, fileCollabParticipantsEvent, 2)
+
+	initialState, err := base64.StdEncoding.DecodeString(syncMessage.Args[1])
+	require.NoError(t, err)
+	browser, browserText := nativeFileCollabTestPeer(t, initialState)
+	defer browser.Destroy()
+	vector := browser.StateVector()
+	update := nativeFileCollabTestInsert(t, browser, browserText, vector, browserText.Len(), " world")
+	split := len(update) / 2
+	require.Greater(t, split, 0)
+
+	require.NoError(t, sender.HandleInbound(senderCtx, Message{Event: FileCollabUpdateEvent, Args: []string{
+		path, "0", base64.StdEncoding.EncodeToString(update[:split]),
+	}}))
+	session := nativeFileCollabRegistry.sessions[nativeFileCollabKey(serverUUID, path)]
+	require.NotNil(t, session)
+	require.Equal(t, "hello", session.text.ToString(), "an incomplete chunk must not mutate the document")
+
+	require.NoError(t, sender.HandleInbound(senderCtx, Message{Event: FileCollabUpdateEvent, Args: []string{
+		path, "1", base64.StdEncoding.EncodeToString(update[split:]),
+	}}))
+	updateMessage := nativeFileCollabRequireEvent(t, recipientConn, FileCollabUpdateEvent, 2)
+	require.Equal(t, path, updateMessage.Args[0])
+	require.Equal(t, base64.StdEncoding.EncodeToString(update), updateMessage.Args[1])
+	require.Equal(t, "hello world", session.text.ToString())
+
+	require.NoError(t, sender.HandleInbound(senderCtx, Message{Event: FileCollabAwarenessEvent, Args: []string{path, "not-base64"}}))
+	awarenessError := nativeFileCollabRequireEvent(t, senderConn, fileCollabErrorEvent, 2)
+	require.Equal(t, path, awarenessError.Args[0])
+	require.Equal(t, "invalid awareness update", awarenessError.Args[1])
+
+	awareness := base64.StdEncoding.EncodeToString([]byte{1, 2, 3, 4})
+	require.NoError(t, sender.HandleInbound(senderCtx, Message{Event: FileCollabAwarenessEvent, Args: []string{path, awareness}}))
+	awarenessMessage := nativeFileCollabRequireEvent(t, recipientConn, FileCollabAwarenessEvent, 2)
+	require.Equal(t, []string{path, awareness}, awarenessMessage.Args)
+
+	require.NoError(t, sender.HandleInbound(senderCtx, Message{Event: FileCollabSaveEvent, Args: []string{path}}))
+	senderSaved := nativeFileCollabRequireEvent(t, senderConn, fileCollabSavedEvent, 2)
+	recipientSaved := nativeFileCollabRequireEvent(t, recipientConn, fileCollabSavedEvent, 2)
+	require.Equal(t, senderSaved.Args, recipientSaved.Args)
+	require.Equal(t, path, senderSaved.Args[0])
+	savedContent, err := os.ReadFile(filepath.Join(s.Filesystem().Path(), "config.txt"))
+	require.NoError(t, err)
+	require.Equal(t, "hello world", string(savedContent))
+
+	require.NoError(t, sender.HandleInbound(senderCtx, Message{Event: FileCollabUnsubscribeEvent, Args: []string{path}}))
+	remaining := nativeFileCollabRequireEvent(t, recipientConn, fileCollabParticipantsEvent, 2)
+	require.JSONEq(t, `[{"user":"recipient","name":"recipient","avatar":null}]`, remaining.Args[1])
+
+	require.NotEqual(t, nativeFileCollabKey(serverUUID, path), nativeFileCollabKey("other-server", path))
+	require.NotEqual(t, nativeFileCollabKey(serverUUID, path), nativeFileCollabKey(serverUUID, otherPath))
+	require.NoError(t, isolatedConn.SetReadDeadline(time.Now().Add(100*time.Millisecond)))
+	var unexpected Message
+	require.Error(t, isolatedConn.ReadJSON(&unexpected), "a different file session must receive no collaboration broadcasts")
+}
