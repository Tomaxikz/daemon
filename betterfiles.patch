+func (s *Server) FileRevisionContent(id int64) ([]byte, string, error) {
+	if !config.Get().System.FileHistory.Enabled {
+		return nil, "", sql.ErrNoRows
+	}
+	store, err := s.fileHistoryStore()
+	if err != nil {
+		return nil, "", err
+	}
+	return store.content(id)
+}
