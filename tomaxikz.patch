+func (h *Handler) betterFilesCollabLeaveAll() {
+	betterFilesCollabMu.Lock()
+	sessions := make([]*betterFilesCollabSession, 0, len(betterFilesCollabSessions))
+	for _, session := range betterFilesCollabSessions {
