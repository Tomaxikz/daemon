+type searchV2CountingReader struct {
+	io.Reader
+	bytes      int
+	maxRequest int
+	cancel     context.CancelFunc
+}
+
+func (r *searchV2CountingReader) Read(p []byte) (int, error) {
+	if len(p) > r.maxRequest {
+		r.maxRequest = len(p)
+	}
+	n, err := r.Reader.Read(p)
+	r.bytes += n
+	if r.cancel != nil {
+		r.cancel()
+	}
+	return n, err
+}
