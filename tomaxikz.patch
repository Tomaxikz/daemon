+type serialSyncClient struct {
+	mu            sync.Mutex
+	responses     []remote.ServerConfigurationResponse
+	firstStarted  chan struct{}
+	secondStarted chan struct{}
+	releaseFirst  chan struct{}
+	calls         int
+	servers       []remote.RawServerData
