+	t.Helper()
+	values, ok := event.Data.([]interface{})
+	require.True(t, ok)
+	args := make([]string, len(values))
+	for index, value := range values {
+		args[index], ok = value.(string)
+		require.True(t, ok)
+	}
+	return args
+}
