+	} else {
+		result, err = execInContainer(ctx, r.env, []string{r.bin, "--version"}, gitContainerRoot)
+	}
+	if err != nil || result.ExitCode != 0 {
+		return ""
+	}
+	return strings.TrimSpace(result.Stdout)
