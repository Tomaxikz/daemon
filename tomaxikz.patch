+func gitVersion(ctx context.Context, env *docker.Environment, gitBin string) string {
+	result, err := execInContainer(ctx, env, []string{gitBin, "--version"}, gitContainerRoot)
+	if err != nil || result.ExitCode != 0 {
+		return ""
+	}
