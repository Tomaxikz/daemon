+
+func gitRemoteConfigURLs(repositoryURL string) []string {
+	if strings.HasSuffix(repositoryURL, "/") {
+		return []string{repositoryURL}
+	}
+	return []string{repositoryURL, repositoryURL + "/"}
+}
